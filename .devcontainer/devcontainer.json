// GitHub Codespaces: open Mixt AI in the browser with nothing installed on your computer.
// On GitHub: Code -> Codespaces -> "Create codespace on <branch>". The first start builds the demo
// (5 to 10 minutes); the dashboard then opens in a new tab and the sign-in details are printed in
// the terminal (or run: infra/demo/demo.sh info). Synthetic data only. See infra/demo/README.md.
{
  "name": "Mixt AI demo",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": { "cpus": 2, "memory": "8gb", "storage": "32gb" },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Mixt AI dashboard", "onAutoForward": "openBrowser" }
  },
  "postStartCommand": "infra/demo/demo.sh start --yes",
  "postAttachCommand": "infra/demo/demo.sh info",
  "waitFor": "postStartCommand",
  "customizations": {
    "codespaces": { "openFiles": ["infra/demo/README.md"] }
  }
}
