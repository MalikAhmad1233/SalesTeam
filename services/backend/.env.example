# Copy to .env for local development. Never commit .env.
MIXT_ENV=local
MIXT_DATABASE_URL=postgresql+psycopg://mixt:mixt-local-only@localhost:5432/mixt_dev
# Generate a key: python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
MIXT_ENCRYPTION_KEYS={"local-1":"<paste-generated-key>"}
MIXT_ACTIVE_ENCRYPTION_KEY_ID=local-1
# Local http only; must be true in staging and production.
MIXT_COOKIE_SECURE=false
MIXT_LOG_JSON=false
