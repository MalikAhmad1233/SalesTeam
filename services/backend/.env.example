# Copy to .env for local development. Never commit .env.
MIXT_ENV=local
MIXT_DATABASE_URL=postgresql+psycopg://mixt:mixt-local-only@localhost:5432/mixt_dev
# Generate a key: python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
MIXT_ENCRYPTION_KEYS={"local-1":"<paste-generated-key>"}
MIXT_ACTIVE_ENCRYPTION_KEY_ID=local-1
# Local http only; must be true in staging and production.
MIXT_COOKIE_SECURE=false
MIXT_LOG_JSON=false

# --- Phase 1d (all optional locally; see docs/14-operations-runbook.md) ---------------------------
# Migrations as the schema owner (defaults to MIXT_DATABASE_URL locally). In staging/production the
# API's MIXT_DATABASE_URL is a data-only role; `python -m mixt.cli migrate --app-role ...` grants it.
# MIXT_MIGRATION_DATABASE_URL=postgresql+psycopg://mixt_owner:...@localhost:5432/mixt_dev
# Shared rate limits (required in staging/production; in-memory locally when unset).
# MIXT_REDIS_URL=redis://localhost:6379/0
# Proxies allowed to set X-Forwarded-For (JSON list of addresses or networks).
# MIXT_TRUSTED_PROXIES=["127.0.0.1/32"]
# Rate limits: count/period with s, m, h or d (defaults shown).
# MIXT_RATE_API_PER_IP=1200/1m
# MIXT_RATE_API_PER_USER=600/1m
# MIXT_RATE_LOGIN_PER_IP=30/15m
# MIXT_RATE_LOGIN_PER_ACCOUNT=10/15m
# MIXT_RATE_MFA_PER_SESSION=10/5m
# MIXT_RATE_PASSWORD_PER_USER=5/15m
# MIXT_RATE_SSO_PER_IP=30/15m
# MIXT_RATE_IMPORT_PER_USER=20/1h
# Single sign-on client credentials; the provider is chosen in Settings (auth.sso).
# MIXT_PUBLIC_BASE_URL=http://localhost:3000
# MIXT_SSO_GOOGLE_CLIENT_ID=
# MIXT_SSO_GOOGLE_CLIENT_SECRET=
# MIXT_SSO_MICROSOFT_CLIENT_ID=
# MIXT_SSO_MICROSOFT_CLIENT_SECRET=
# MIXT_SSO_MICROSOFT_TENANT_ID=
# MIXT_SSO_ALLOWED_DOMAINS=["mixt.example"]
